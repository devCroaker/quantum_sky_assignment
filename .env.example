# Copy to .env for local overrides. Never commit a filled-in .env.
# Paths to the committed input files, relative to the repository root.
NETSCOPE_SNDLIB_PATH=data/nobel-eu.xml
NETSCOPE_SITES_PATH=data/sites.csv

# Capacity applied to every backbone link, per R3.
NETSCOPE_BACKBONE_CAPACITY=550

# API server bind address.
NETSCOPE_HOST=127.0.0.1
NETSCOPE_PORT=8000

# The front end reads its own template, because Vite only picks up variables
# from the directory it runs in and only those prefixed VITE_. See
# frontend/.env.example for VITE_DATA_SOURCE, which selects the committed
# fixtures or the live API.
