# Copy to frontend/.env for local overrides. Never commit a filled-in .env.
#
# Which NetworkDataSource the view uses. "fixture" reads the payloads committed in
# contracts/fixtures/ and needs no back end. "live" calls the four endpoints in
# docs/api-contract.md under /api, which the dev server proxies to 127.0.0.1:8000.
# Unset means fixture, so a fresh checkout runs with nothing else started.
VITE_DATA_SOURCE=fixture
